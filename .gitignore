# vcpkg — the entire bootstrap tree is derived, don't track it as an
# embedded git repo. `cmake/build.ps1` re-clones on a fresh checkout.
third_party/vcpkg/
vcpkg_installed/

# Local scheduler lock and other .claude session state
.claude/

