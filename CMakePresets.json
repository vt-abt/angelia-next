{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja + MSVC (Release with debug info)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/third_party/vcpkg"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Ninja + MSVC (Debug)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug",   "configurePreset": "debug"   }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": {"outputOnFailure": true} }
  ]
}
